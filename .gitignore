# scripts y archivos auxiliares de CI/deploy que NO queremos trackear
# (estos son locales de un servidor específico, no parte de la app)
deploy.sh
docker-compose.ci.yml
docker-compose.override.yml
# nginx.conf SI se trackea (auditoría 2026-07-26): docker-compose.yml lo monta
# como bind mount de solo lectura y el flujo de deploy documentado es
# git clone/pull en el VPS -- si no está en el repo, nunca llega ahí. No
# contiene secretos (server_name genérico, certs se montan aparte desde
# ./certs/, que sigue gitignored más abajo).

# .github/ SI se trackea — contiene /workflows/ci.yml necesario para
# que GitHub Actions encuentre el pipeline de lint/tsc/build/test/audit.
# Si añadís secrets locales o scripts one-off, ponelos en .github/_local/
# (excluido a continuación) o en un .gitignore_global/.git/info/exclude.
.github/_local/

# Certificados TLS locales autofirmados (nginx, dev/testing) -- nunca reales
certs/
