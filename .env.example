# ════════════════════════════════════════
# GUIDO PIZZA — Template de Variables de Entorno
# Copiar a .env y completar con valores reales
# NO.commitear valores reales
# ════════════════════════════════════════

# ── API Keys ───────────────────────────
# Obtener en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Frontend (Vite) ──────────────────────
VITE_API_URL=http://localhost:3001

# ── Database (Turso) ────────────────────
# Obtener en: https://console.turso.io
TURSO_DATABASE_URL=libsql://your-org.your-db.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ── Server ────────────────────────────
PORT=3001
NODE_ENV=development

# ── Seguridad (generar con: openssl rand -hex 32) ─
JWT_SECRET=your_jwt_secret_min_32_chars_long
SESSION_SECRET=your_session_secret_min_32_chars_long

# ── Rate Limiting ────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100