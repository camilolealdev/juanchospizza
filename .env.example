# ═══════════════════════════════════════════════════════════════════════
#  Guido Pizza — Juancho's Pizza
#  Variables de Entorno (desarrollo local)
#
#  ⚠️  NUNCA commitees .env ni .env.production al repositorio.
# ═══════════════════════════════════════════════════════════════════════

# ─── App ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Postgres ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guido_pizza
PG_POOL_MAX=20
PG_IDLE_TIMEOUT=30000
PG_CONNECT_TIMEOUT=5000
# PGSSLMODE=require
# PGSSL_REJECT_UNAUTHORIZED=false

# ─── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ────────────────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_64_chars_hex
JWT_EXPIRES_IN=15m

# ─── Gemini AI ──────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── Pagos: Bold ───────────────────────────────────────────────────
BOLD_API_KEY=
BOLD_WEBHOOK_SECRET=

# ─── Pagos: MercadoPago ─────────────────────────────────────────────
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ─── Pagos: Wompi ───────────────────────────────────────────────────
WOMPI_MERCHANT_ID=
WOMPI_PUBLIC_KEY=
WOMPI_EVENTS_SECRET=

# ─── Pagos: PayPal ──────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ─── SMTP ───────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Guido Pizza <noreply@guidopizza.com>"

# ─── Push Notifications (VAPID) ─────────────────────────────────────
VAPID_MAILTO=mailto:admin@guidopizza.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── DIAN ───────────────────────────────────────────────────────────
DIAN_ENVIRONMENT=sandbox
DIAN_TECHNICAL_KEY=
DIAN_PIN=
DIAN_SOFTWARE_ID=
DIAN_AUTHORIZATION_NUMBER=
DIAN_NIT=123456789
DIAN_ESTABLISHMENT=00001
DIAN_POS=00001

# ─── Service Keys ───────────────────────────────────────────────────
# SERVICE_KEY_N8N=tu_clave

# ─── Backup ─────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BACKUP_BUCKET=guidopizza-backups

# ─── Logging ────────────────────────────────────────────────────────
LOG_LEVEL=debug
