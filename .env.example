# ════════════════════════════════════════
# GUIDO PIZZA — Template de Variables de Entorno
# Copiar a .env y completar con valores reales
# NO.commitear valores reales
# ════════════════════════════════════════

# ── API Keys ───────────────────────────
# Obtener en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Frontend (Vite) ──────────────────────
VITE_API_URL=http://localhost:3001

# ── Database (PostgreSQL) ────────────────
# Full connection string, e.g. postgresql://user:password@host:5432/dbname
# (add ?sslmode=require when connecting to a managed/hosted Postgres instance)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guido_pizza

# ── Server ────────────────────────────
PORT=3001
NODE_ENV=development
# Deja pasar requests sin token cuando NODE_ENV=development -- requiere
# ambas variables a propósito. Nunca setear en producción.
ALLOW_DEV_AUTH_BYPASS=false

# ── Seguridad (generar con: openssl rand -hex 32) ─
JWT_SECRET=your_jwt_secret_min_32_chars_long
SESSION_SECRET=your_session_secret_min_32_chars_long

# ── Rate Limiting ────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── Push Notifications (Web Push / VAPID) ─
# Generar un par de claves con: npx web-push generate-vapid-keys
# Si estas 3 variables faltan, el envío de notificaciones simplemente se
# deshabilita (log de advertencia) — nunca tumba el servidor ni el build.
VAPID_MAILTO=mailto:tucorreo@example.com
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
# Mismo valor que VAPID_PUBLIC_KEY, pero expuesto al frontend (prefijo VITE_)
# para que el navegador pueda suscribirse a push desde pushManager.subscribe().
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# ── Pagos Bold (Colombia) ────────────────
# Llave de identidad (pública), obtener en: https://developers.bold.co
# Server-side only — el link de pago se crea en el backend, nunca en el navegador.
BOLD_API_KEY=your_bold_identity_key_here
# Secreto para verificar que el webhook de confirmación de pago realmente
# viene de Bold. Sin verificación real confirmada contra su documentación --
# revisar antes de aceptar pagos reales (ver comentario en el webhook).
BOLD_WEBHOOK_SECRET=your_bold_webhook_secret_here

# ── Pagos MercadoPago, Wompi, PayPal ──────
# Todas server-side only — el backend crea el pago/transacción, el
# navegador nunca ve estos secretos.
MP_ACCESS_TOKEN=your_mercadopago_access_token_here
# Clave secreta de webhooks (Tus integraciones > Notificaciones webhooks en
# el panel de MercadoPago). Si falta, el webhook igual procesa pagos pero
# sin verificar que la notificación venga realmente de MercadoPago.
MP_WEBHOOK_SECRET=your_mercadopago_webhook_secret_here
WOMPI_MERCHANT_ID=your_wompi_merchant_id_here
# "Secreto de eventos" (events secret) del panel de Wompi -- distinto de la
# llave pública/privada de transacciones. Igual: opcional pero recomendado.
WOMPI_EVENTS_SECRET=your_wompi_events_secret_here
# NOTE: PayPal route below is a redirect stub carried over as-is from the
# original code (never called PayPal's real Orders API) -- only gates on
# PAYPAL_CLIENT_ID being set. A real integration needs OAuth + client secret.
PAYPAL_CLIENT_ID=your_paypal_client_id_here

# ── Notificaciones / Webhooks ──────────────
# URL opcional para recibir webhooks cuando cambia el estado de un pedido.
# Si no se configura, los webhooks simplemente no se envían (sin errores).
ORDER_WEBHOOK_URL=https://hooks.example.com/orders
# URL opcional para webhooks de pagos (confirmado/rechazado).
# Si no se configura, se usa ORDER_WEBHOOK_URL si existe, o no se envía nada.
PAYMENT_WEBHOOK_URL=https://hooks.example.com/payments