# ════════════════════════════════════════════════════════════════════════════
# JUANCHO'S PIZZA — Production Environment (.env.production.example)
# ════════════════════════════════════════════════════════════════════════════
# CÓMO USAR ESTE ARCHIVO:
#   1. En el VPS: `cp .env.production.example .env.production`
#   2. Reemplazar CADA `your_*_here` o `changeme_*` con valores REALES.
#   3. NUNCA commitear el archivo `.env.production` resultante (ya está en
#      .gitignore — verificarlo con `git status` antes de cualquier push).
#
# CÓMO GENERAR SECRETOS:
#   - JWT_SECRET / SESSION_SECRET / SERVICE_KEY: `openssl rand -hex 32`
#   - POSTGRES_PASSWORD: `openssl rand -base64 24 | tr -d /=+ | cut -c1-32`
#   - VAPID keys: `npx web-push generate-vapid-keys`
#
# VALIDACIÓN:
#   El backend (server/config.js → validateConfig) requiere al menos
#   DATABASE_URL y GEMINI_API_KEY no vacíos al arrancar; si esos faltan,
#   el proceso hace process.exit(1) antes de abrir el puerto.
#
# ⚠️  Si una variable NO está en este archivo pero docker-compose.yml la
#     referencia con ${VAR}, Docker simplemente va a fallar al arrancar —
#     este archivo es la fuente de verdad para TODO .env.production.
# ════════════════════════════════════════════════════════════════════════════

# ─── Database (compose construye DATABASE_URL a partir de POSTGRES_PASSWORD) ──
# Solo POSTGRES_PASSWORD vive en .env.production; DATABASE_URL se arma en
# docker-compose.yml como: postgres://postgres:${POSTGRES_PASSWORD}@postgres:5432/juanchos_pizza
# server/config.js lee la DATABASE_URL resultante para validar al boot.
# server/db.js NO activa SSL por defecto (el postgres:17-alpine del propio
# compose no lo tiene configurado). Si en algún momento se apunta DATABASE_URL
# a un Postgres gestionado externo (Neon/Railway/RDS), agregar acá:
# PGSSLMODE=require
POSTGRES_PASSWORD=changeme_secure_password_here

# ─── Redis ──────────────────────────────────────────────────────────────────
# También lo inyecta compose directamente (`redis://redis:6379`). Se incluye
# acá para que server/*js pueda leer REDIS_URL sin tener que extenderlo.
REDIS_URL=redis://redis:6379

# ─── Backend runtime ────────────────────────────────────────────────────────
# Dejar fijo en production. El compose ya lo fuerza, pero si se omite el
# validateConfig puede arrancar en development por accidente.
NODE_ENV=production
PORT=3001

# ─── Seguridad / Auth ───────────────────────────────────────────────────────
# openssl rand -hex 32 → 64 chars hex. CRÍTICO: cambiar antes de salir a
# internet. Mismo valor entre reinicios para que los JWT viejos sigan válidos.
JWT_SECRET=changeme_32_char_minimum_secret_here
JWT_EXPIRES_IN=15m
# Clave usada por integraciones internas / webhooks salientes. Generar
# también con `openssl rand -hex 32`. server/services/* usa esto como
# "service-key" header para autenticarse a sí mismo entre módulos.
SERVICE_KEY=changeme_service_key_hex32
# Reservado para express-session si se migra desde JWT-only. Misma regla
# que JWT_SECRET (openssl rand -hex 32). Si sobra, podés dejarla vacía.
SESSION_SECRET=changeme_session_secret_hex32

# ─── CORS / URLs públicas ───────────────────────────────────────────────────
# URL canónica del frontend. OBLIGATORIA en producción. server/index.js la
# usa para validar redirect_url de pasarelas (Host Header Injection guard).
FRONTEND_URL=https://tudominio.com
# URL pública absoluta del backend (sin slash final). Algunos proveedores
# de pago la necesitan para construir webhook URLs.
PUBLIC_URL=https://api.tudominio.com
# Comma-separated origins. La primera entrada DEBE coincidir con FRONTEND_URL.
# Ejemplo: https://tudominio.com,https://www.tudominio.com (sin www y con www
# son orígenes distintos en CORS — listar ambos si el cert cubre ambos).
ALLOWED_ORIGINS=https://tudominio.com,https://www.tudominio.com
# Dev bypass: requiere NODE_ENV=development para ser efectivo. Mantener en
# `false` en producción — sirve como kill-switch explícito.
ALLOW_DEV_AUTH_BYPASS=false

# ─── Webhooks salientes ─────────────────────────────────────────────────────
# Opcionales: si no se configuran, los webhooks simplemente no se envían
# (sin errores). Si se definen, el server/services/* los golpea con fetch.
WEBHOOK_URL=https://hooks.example.com/generic
ORDER_WEBHOOK_URL=https://hooks.example.com/orders
PAYMENT_WEBHOOK_URL=https://hooks.example.com/payments

# ─── Gemini AI (cliente + servidor) ─────────────────────────────────────────
# La misma key se usa server-side (config.js) y frontend-side si se sube
# con prefijo VITE_ a la build. Preferible: una sola key con cuota amplia
# y restringir por dominio/referer en Google AI Studio.
# Server-side (server/config.js valida que exista).
GEMINI_API_KEY=your_gemini_api_key_here
# Frontend-side (vite bake-in). OJO: queda visible en el bundle del
# navegador. Si el dominio tiene referer-restriction estricto, es seguro;
# si no, sacar el prefijo VITE_ y solo usarlo desde el backend.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ─── API pública del backend (frontend bundle) ──────────────────────────────
# Aparece hardcoded en el bundle JS del navegador. Apuntar SIEMPRE al
# dominio canónico detrás del nginx (NO la IP del VPS).
VITE_API_URL=https://api.tudominio.com
# Nequi (opcional, frontend): número de cuenta Nequi del comerciante
# que se muestra al cliente en el checkout. No es secreto.
VITE_NEQUI_API_KEY=
VITE_NEQUI_PHONE=

# ─── SMTP (server/services/email.js) ────────────────────────────────────────
# Sugerencia: usar Gmail con App Password (no la contraseña directa).
# Si se usa SES/Postmark/SendGrid, ajustar SMTP_HOST y SMTP_SECURE=false.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_smtp_app_password_here
SMTP_FROM="Juancho's Pizza <noreply@tudominio.com>"

# ─── DIAN — Facturación electrónica Colombia ─────────────────────────────────
# ⚠️  Sin esto no hay factura electrónica. 5–10 días de coordinación externa
#     (certificado digital + homologación del proveedor tecnológico).
#
# Proveedor tecnológico. Cambia el adapter activo en
# server/services/dianProvider.js. Valores válidos: muisca | dataico |
# novasoft | alegra. Si no se elige, el sistema no firma ni envía.
DIAN_PROVIDER=muisca
# Ambiente: '1' = pruebas (Habilitación), '2' = producción.
# Empezar con '1' hasta que la DIAN apruebe Habilitación, después cambiar a '2'.
DIAN_AMBIENTE=1
# URL base del proveedor tecnológico (sin slash final). Viene preconfigurada
# por proveedor arriba — solo editarla si el proveedor da una URL distinta.
#DIAN_PROVIDER_URL=https://ccdn.dian.gov.co
#DIAN_PROVIDER_URL=https://api.dataico.com
#DIAN_PROVIDER_URL=https://api.novasoft.com.co/api/v1
#DIAN_PROVIDER_URL=https://api.alegra.co/api/v1
# Ruta absoluta al certificado .p12 emitido por entidad autorizada
# (Andrés Díaz / Certicámara / GSE). NO commitear el .p12 al repo.
DIAN_CERT_PATH=/etc/juanchos-pizza/certificado.p12
DIAN_CERT_PASSWORD=changeme_dian_cert_password
# Clave técnica asignada por la DIAN al registrar el software propio
# (no del proveedor tecnológico, salvo Alegra que la oculta).
DIAN_CLAVE_TECNICA=tu-clave-tecnica-dian-aqui
# Número de resolución de autorización de numeración (rango DIAN).
DIAN_RESOLUCION_NUMERO=1876000000001

# ─── Credenciales por proveedor DIAN (dejar vacías las que NO apliquen) ────
# Alegra (REST, la más simple para arrancar).
ALEGRA_USER=your_alegra_user_here
ALEGRA_TOKEN=your_alegra_token_here
# Muisca (SOAP/XML directo ccdn.dian.gov.co — sin intermediario).
MUISCA_TOKEN=your_muisca_token_here
# Dataico (REST/SOAP contra api.dataico.com).
DATAICO_API_KEY=your_dataico_api_key_here
# Novasoft (REST contra api.novasoft.com.co).
NOVASOFT_USER=your_novasoft_user_here
NOVASOFT_PASSWORD=your_novasoft_password_here

# ─── Push Notifications / Web Push (VAPID) ──────────────────────────────────
# Generar con: `npx web-push generate-vapid-keys`
# Si VAPID_PUBLIC_KEY falta, el envío se deshabilita silenciosamente (log
# de advertencia) — nunca rompe el boot.
VAPID_MAILTO=mailto:noreply@tudominio.com
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
# Mismo valor que VAPID_PUBLIC_KEY pero expuesto al bundle frontend
# (prefijo VITE_) para que el service worker pueda suscribirse.
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# ─── Payment gateways ───────────────────────────────────────────────────────
# Todas server-side only — el backend crea el link/preferencia/transacción,
# el navegador NUNCA ve ninguno de estos secretos.

# Bold (cobertura principal Colombia).
# Identity key pública, obtener en https://developers.bold.co
BOLD_API_KEY=your_bold_identity_key_here
# Secreto para verificação del webhook de confirmación.
BOLD_WEBHOOK_SECRET=your_bold_webhook_secret_here

# MercadoPago.
# Access token (Tus integraciones > Credenciales en el panel de MP).
MP_ACCESS_TOKEN=your_mercadopago_access_token_here
# Secreto de notificaciones webhooks (Tus integraciones > Notificaciones).
# Si falta, el webhook procesa pero sin verificar origen (riesgo medio).
MP_WEBHOOK_SECRET=your_mercadopago_webhook_secret_here

# Wompi.
WOMPI_MERCHANT_ID=your_wompi_merchant_id_here
# "Secreto de eventos" — distinto de las llaves pública/privada de transacción.
WOMPI_EVENTS_SECRET=your_wompi_events_secret_here

# PayPal.
# NOTA: el route actual es un redirect stub heredado (nunca llamó a la Orders
# API real de PayPal). Solo se activa si PAYPAL_CLIENT_ID está seteado. Para
# integración real hace falta OAuth + client secret.
PAYPAL_CLIENT_ID=your_paypal_client_id_here

# ─── Rate limiting ──────────────────────────────────────────────────────────
# Ventana y máximo de requests por IP para /api/* (Express-rate-limit).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ─── PostgreSQL connection pool (pg) ────────────────────────────────────────
# server/db.js usa node-postgres. Los defaults ya están bien, ajustar solo
# si en el VPS aparecen errores de "too many clients" o conexiones idle.
PG_POOL_MAX=20
PG_IDLE_TIMEOUT=30000
PG_CONNECT_TIMEOUT=5000
