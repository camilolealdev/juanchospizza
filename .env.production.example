# ════════════════════════════════════════
# GUIDO PIZZA — Production Environment
# Copy to .env.production and fill in REAL values
# NEVER commit this file with real secrets
# ════════════════════════════════════════

# ── Database ────────────────────────────
POSTGRES_PASSWORD=changeme_secure_password_here

# ── Security (generate: openssl rand -hex 32) ────────────────────────────
JWT_SECRET=changeme_32_char_minimum_secret_here

# ── API Keys ────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── CORS ────────────────────────────
ALLOWED_ORIGINS=https://tudominio.com,https://www.tudominio.com

# ── Pagos Bold (Colombia) ────────────────────────────
BOLD_API_KEY=your_bold_identity_key_here
BOLD_WEBHOOK_SECRET=your_bold_webhook_secret_here

# ── Pagos MercadoPago ────────────────────────────
MP_ACCESS_TOKEN=your_mercadopago_access_token_here
MP_WEBHOOK_SECRET=your_mercadopago_webhook_secret_here

# ── Pagos Wompi ────────────────────────────
WOMPI_MERCHANT_ID=your_wompi_merchant_id_here
WOMPI_EVENTS_SECRET=your_wompi_events_secret_here

# ── Pagos PayPal ────────────────────────────
PAYPAL_CLIENT_ID=your_paypal_client_id_here

# ── Rate Limiting ────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100