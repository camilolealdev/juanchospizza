# =============================================================================
# Juancho's Pizza / GastroPro v2.0 — Variables de Entorno para Producción
# Copiar a .env.production y completar antes de docker compose up
# =============================================================================

# ── Base de Datos ──────────────────────────────────────────────────
# PostgreSQL connection string
# Formato: postgres://usuario:password@host:5432/juanchos_pizza
# En Docker Compose, host = "postgres" (nombre del servicio)
# REQUERIDO — server/index.js hace process.exit(1) al boot si falta.
DATABASE_URL=postgres://postgres:CHANGE_ME@postgres:5432/juanchos_pizza
POSTGRES_PASSWORD=CHANGE_ME
# Opcional. server/db.js NO activa SSL por defecto (el postgres:17-alpine
# del propio compose no lo tiene configurado). Setear PGSSLMODE=require
# solo si DATABASE_URL apunta a un Postgres gestionado externo (Neon/
# Railway/RDS) que lo exija.
PGSSLMODE=
# Opcional. Con SSL activado (arriba), por defecto valida el certificado
# del servidor. Poner en "false" únicamente si el proveedor usa un
# certificado autofirmado (no recomendado).
PGSSL_REJECT_UNAUTHORIZED=true

# ── Redis ───────────────────────────────────────────────────────────
# Opcional. Si no se configura, usa rate-limit en memoria (no persistente)
REDIS_URL=redis://redis:6379

# ── JWT ──────────────────────────────────────────────────────────────
# Generar con: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_genera_con_openssl_rand_hex_32
JWT_EXPIRES_IN=15m

# ── Service Key (auth de servicio a servicio para n8n / cron) ───────
# server/middleware/serviceKey.js valida el header "x-service-key" en
# requests que no traen un JWT de usuario humano. Sin ninguna de estas
# vars, ese middleware simplemente no registra servicios válidos y todo
# request de n8n/cron que dependa de x-service-key será rechazado (403).
# Generar cada una con: openssl rand -hex 32
# Preferido: una clave por servicio, así se pueden rotar/revocar por separado.
SERVICE_KEY_N8N=
SERVICE_KEY_CRON=
# Genérica de compatibilidad hacia atrás (cualquier servicio que la use
# se autentica como "generic-service" con rol ADMIN). Opcional si ya se
# usan las específicas de arriba.
SERVICE_KEY=

# ── Frontend ────────────────────────────────────────────────────────
# URL pública del frontend (obligatorio en producción)
# Sin esta variable, el server falla al arrancar
FRONTEND_URL=https://tudominio.com
# URL base para llamadas API desde el frontend (vacío = mismo origen)
VITE_API_URL=
# Opcional. URL pública absoluta del backend (sin slash final), usada por
# server/routes/qrMenu.js para construir las URLs de los códigos QR del
# menú. Sin ella cae a http://localhost:<PORT>, lo cual rompe los QR en
# producción.
PUBLIC_URL=https://api.tudominio.com

# ── Gemini AI (Menú Inteligente) ────────────────────────────────────
# Opcional. Sin API key, el menú inteligente se deshabilita gracefulmente
# Obtener en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Misma key pero expuesta al bundle del frontend (prefijo VITE_) para el
# menú inteligente client-side (src/services/geminiService.ts). Queda
# visible en el navegador — restringir por dominio/referer en AI Studio.
VITE_GEMINI_API_KEY=

# ── Pasarelas de Pago (opcionales hasta activarlas) ─────────────────
# Bold (Colombia) — recommended
BOLD_API_KEY=
BOLD_WEBHOOK_SECRET=

# MercadoPago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Wompi
WOMPI_MERCHANT_ID=
WOMPI_EVENTS_SECRET=

# PayPal
PAYPAL_CLIENT_ID=

# Nequi (opcional, frontend-only): datos de cuenta que se muestran al
# cliente en el checkout (src/services/payments/paymentService.ts). No
# son secretos — no hay integración real de API Nequi en el backend.
VITE_NEQUI_API_KEY=
VITE_NEQUI_PHONE=

# ── Push Notifications ──────────────────────────────────────────────
# Generar con: npx web-push generate-vapid-keys
# server/push.js requiere las 3 vars server-side (MAILTO + PUBLIC + PRIVATE);
# si falta cualquiera de las tres, el push se deshabilita silenciosamente
# (solo un warning en logs, nunca rompe el boot).
VAPID_MAILTO=mailto:noreply@tudominio.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Mismo valor que VAPID_PUBLIC_KEY pero expuesto al bundle frontend
# (prefijo VITE_) para que el service worker pueda suscribirse
# (src/services/push.ts). Sin esta, el navegador nunca pide permiso de
# notificación aunque el backend esté bien configurado.
VITE_VAPID_PUBLIC_KEY=

# ── Webhooks salientes ───────────────────────────────────────────────
# Opcionales: si no se configuran, los webhooks simplemente no se envían
# (sin errores). server/routes/orders.js, payments.js y notifications.js
# los golpean con fetch cuando están definidos.
WEBHOOK_URL=
ORDER_WEBHOOK_URL=
PAYMENT_WEBHOOK_URL=

# ── DIAN — Facturación electrónica Colombia ─────────────────────────
# Sin este bloque no hay facturación electrónica real; el sistema no
# firma ni envía. Requiere certificado digital + homologación con un
# proveedor tecnológico antes de poner DIAN_ENVIRONMENT=production.
#
# Modo de envío. server/services/dianSandbox.js:
#   sandbox    → firma pero NO envía al proveedor (simula respuesta)
#   production → envía real al proveedor configurado abajo
DIAN_ENVIRONMENT=sandbox
# Con DIAN_ENVIRONMENT=sandbox, DRY_RUN=true evita incluso firmar
# (solo genera y loggea el XML). Útil para desarrollo, dejar en false
# o vacío en producción real.
DRY_RUN=false
# Proveedor tecnológico activo. server/services/dianProvider.js.
# Valores válidos: muisca | dataico | novasoft | alegra.
DIAN_PROVIDER=muisca
# URL base del proveedor tecnológico (sin slash final).
DIAN_PROVIDER_URL=
# Ambiente DIAN: '1' = pruebas (Habilitación), '2' = producción.
DIAN_AMBIENTE=1
# Ruta absoluta al certificado .p12 emitido por entidad autorizada
# (Andrés Díaz / Certicámara / GSE). NO commitear el .p12 al repo.
# server/services/dianSigner.js lanza error explícito si falta al firmar.
DIAN_CERT_PATH=
DIAN_CERT_PASSWORD=
# Clave técnica asignada por la DIAN al registrar el software propio.
DIAN_CLAVE_TECNICA=

# Credenciales por proveedor DIAN (dejar vacías las que NO apliquen,
# solo se usan las del DIAN_PROVIDER activo arriba)
# Alegra (REST)
ALEGRA_USER=
ALEGRA_TOKEN=
# Muisca (SOAP/XML directo ccdn.dian.gov.co)
MUISCA_TOKEN=
# Dataico (REST/SOAP)
DATAICO_API_KEY=
# Novasoft (REST)
NOVASOFT_USER=
NOVASOFT_PASSWORD=

# ── SMTP (Email) ────────────────────────────────────────────────────
# Opcional. Sin SMTP, los emails de confirmación no se envían
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Juancho's Pizza" <noreply@tudominio.com>

# ── CORS ────────────────────────────────────────────────────────────
# Orígenes permitidos separados por coma
ALLOWED_ORIGINS=https://tudominio.com
# Kill-switch de dev auth bypass. server/auth.js solo lo respeta cuando
# NODE_ENV=development, así que es un no-op en producción real — se deja
# explícito en "false" acá como salvaguarda documentada.
ALLOW_DEV_AUTH_BYPASS=false

# ── Rate Limiting ───────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── PostgreSQL Pool ─────────────────────────────────────────────────
PG_POOL_MAX=20
PG_IDLE_TIMEOUT=30000
PG_CONNECT_TIMEOUT=5000

# ── Entorno ─────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
PORT=3001
